# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# --- Required ---
# JWT signing key (HS512 needs >= 64 bytes). Generate: openssl rand -hex 64
JWT_SECRET=
# Refresh-token signing key, >= 64 bytes and different from JWT_SECRET. Generate: openssl rand -hex 64
JWT_REFRESH_SECRET=
# Key for hashing OTP codes, >= 32 chars. Generate: openssl rand -hex 32
OTP_HMAC_SECRET=

# --- Production only (docker-compose.prod.yml, see DEPLOY.md) ---
# Postgres password. Generate: openssl rand -hex 24
DB_PASSWORD=

# --- Image URLs (optional) ---
# Base of the image URLs sent to the app (avatars, logos, products). Default http://localhost:8081.
# When testing on a phone, use the PC's LAN address, the same host as apiBaseUrl in the app's environment.ts.
APP_PUBLIC_BASE_URL=

# --- Token lifetimes (optional, milliseconds) ---
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Google Sign-In (optional) ---
# OAuth 2.0 *Web application* client ID from Google Cloud Console (APIs & Services > Credentials).
# Must match googleClientId in the app's environment files; add the app's origins as "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# --- Email delivery of verification codes (SMTP) ---
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=<gmail address>, MAIL_PASSWORD=<16-char app password>
# Mailtrap sandbox: values from the inbox's SMTP settings
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_STARTTLS=true
# false only for a local test server without login (e.g. Mailpit)
MAIL_SMTP_AUTH=true
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Oxtore

# --- WhatsApp delivery (optional, Twilio) ---
# none | twilio
WHATSAPP_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp-enabled sender in E.164, e.g. +14155238886 (sandbox)
TWILIO_PHONE=
# Approved WhatsApp authentication template (code as {{1}}); required outside the sandbox
TWILIO_WHATSAPP_CONTENT_SID=

# --- Local development only ---
# SPRING_PROFILES_ACTIVE=dev with OTP_DEV_LOG_CODES=true logs codes for channels without a provider.
SPRING_PROFILES_ACTIVE=
OTP_DEV_LOG_CODES=false
